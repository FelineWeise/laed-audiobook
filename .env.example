# Budgeted consumer key from llm-gateway (not LITELLM_MASTER_KEY).
# On a Mac, use the public Caddy hostname (not http://litellm:4000/v1).
LLM_GATEWAY_URL=https://litellm.laed.eu/v1
LLM_GATEWAY_KEY=

# Required when calling through LAED Caddy basicauth from outside the VPC.
# CADDY_USER=
# CADDY_PASS=

# Optional overrides
# AUDIOBOOK_CHAT_MODEL=scaleway/mistral-small
# AUDIOBOOK_TTS_MODEL=tts/kokoro
# AUDIOBOOK_TTS_VOICE=af_heart
# AUDIOBOOK_TTS_SPEED=1.0
# AUDIOBOOK_CHUNK_WORDS=220
# AUDIOBOOK_OUTPUT_DIR=/Users/you/Desktop
